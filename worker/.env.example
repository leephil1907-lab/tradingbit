# ============================================================
# Mode — PAPER MODE IS THE DEFAULT. Do NOT flip to live until
# you have stress-tested for weeks and accept total loss of capital.
# ============================================================
PAPER_MODE=true
INITIAL_BALANCE=500.0
MAX_POSITION_USD=50.0
MAX_OPEN_POSITIONS=10
STOP_LOSS_PCT=-6.0
TAKE_PROFIT_2X=2.0
TAKE_PROFIT_3X=3.0
PARTIAL_AT_2X=0.40
PARTIAL_AT_3X=0.30
TRAIL_PCT=8.0
POSITION_FEE_PCT=0.3

# Minimum agents that must agree before Core buys
MIN_AGREEING_AGENTS=2

# Chains to watch
CHAINS=sol,base,bsc

# Live DexScreener feed (no key needed). Disable with --no-live-dex or LIVE_DEX=false
LIVE_DEX=true
DEX_REFRESH_SECONDS=20.0

# GMGN (from gmgn.ai / gmgn-skills) — optional, only needed if you wire GMGN feeds
GMGN_API_KEY=your_gmgn_api_key_here

# Solana (for real sniping — use a PRIVATE node, never public RPC for live sniping)
SOLANA_RPC_HTTP=https://your-private-solana-rpc
SOLANA_RPC_WSS=wss://your-private-solana-wss
GEYSER_ENDPOINT=
GEYSER_TOKEN=

# Optional live wallet (NEVER commit real keys — paper mode needs none)
# SOLANA_PRIVATE_KEY=
# EVM_PRIVATE_KEY=

# Dashboard
DASHBOARD_REFRESH=2.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/decisions.jsonl
